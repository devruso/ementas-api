LIBREOFFICE_BIN=/usr/bin/libreoffice
PDF_CONVERSION_TIMEOUT_MS=45000

SUPER_ADMIN_EMAIL=
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_PASSWORD=

# File storage provider (incremental rollout)
STORAGE_PROVIDER=local
STORAGE_LOCAL_BASE_PATH=storage
STORAGE_S3_ENABLED=false
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_FORCE_PATH_STYLE=true
STORAGE_S3_PUBLIC_BASE_URL=

# Startup bootstrap import (optional)
BOOTSTRAP_IMPORT_ON_EMPTY_DB=false
BOOTSTRAP_IMPORT_SOURCE=sigaa-public
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=Bootstrap Super Admin
BOOTSTRAP_ADMIN_PASSWORD=

# SIGAA startup bootstrap source (used when BOOTSTRAP_IMPORT_SOURCE=sigaa-public)
BOOTSTRAP_SIGAA_SOURCE_TYPE=department
BOOTSTRAP_SIGAA_SOURCE_ID=
BOOTSTRAP_SIGAA_ACADEMIC_LEVEL=all

# SIAC startup bootstrap source (used when BOOTSTRAP_IMPORT_SOURCE=siac)
BOOTSTRAP_SIAC_CD_CURSO=
BOOTSTRAP_SIAC_NU_PER_CURSO_INICIAL=

# Optional maintenance/debug variables
RECONCILE_BOOTSTRAP_EMAIL=
RECONCILE_BOOTSTRAP_NAME=Reconcile Bot
RECONCILE_BOOTSTRAP_PASSWORD=
CRAWLER_SIGAA_DEBUG_DETAIL=0
CRAWLER_SIGAA_DEBUG_CODES=
CRAWLER_SIGAA_DEBUG_DIR=tmp/sigaa-detail-debug

